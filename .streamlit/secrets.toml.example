# Copy this file to .streamlit/secrets.toml and set your team credentials.
# Never commit the real secrets.toml file.
FIREWATCH_USERNAME = "replace-with-your-username"
FIREWATCH_PASSWORD = "replace-with-a-strong-password"

# Optional: free NASA FIRMS key for live data.
# Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY = ""

# Optional: where ground reports are saved (default: data/feedback.csv).
# FIREWATCH_FEEDBACK_PATH = "data/feedback.csv"
